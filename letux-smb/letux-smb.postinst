#! /bin/sh
# post script for letux-smb
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <new-preinst> `install'
#        * <new-preinst> `install' <old-version>
#        * <new-preinst> `upgrade' <old-version>
#        * <old-preinst> `abort-upgrade' <new-version>
#
# For details see /usr/share/doc/packaging-manual/

case "$1" in
    configure)
		echo "deactivate nmbd" >&2

		service nmbd stop >/dev/null 2>&1 || true

		if [ -x /usr/bin/deb-systemd-helper -a "$(which systemctl)" ]
		then
		        systemctl disable nmbd >/dev/null 2>&1 || true
			systemctl mask nmbd >/dev/null 2>&1 || true
		elif [ -x /usr/sbin/update-rc.d ]
		then
			update-rc.d -f nmbd remove >/dev/null 2>&1 || true
			update-rc.d nmbd disable >/dev/null 2>&1 || true
    		fi

		echo "Restarting smbd..." >&2
		if [ -x /usr/bin/deb-systemd-helper -a "$(which systemctl)" ]
		then
			systemctl restart smbd.service
		else
			killall smbd
			/usr/sbin/smbd -D
		fi
		echo "... restarted." >&2
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 0
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0

